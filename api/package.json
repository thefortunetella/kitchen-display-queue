{
  "name": "api",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:setup": "node scripts/wait-for-db.js && sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "jest",
    "test:unit": "jest --selectProjects unit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  }
}
