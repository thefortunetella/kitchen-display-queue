{
  "info": {
    "name": "Kitchen Queue API",
    "description": "Every endpoint of the Kitchen Queue API, with status checks. Run `npm run db:setup` and `npm run dev` first.\n\nMenu item ids follow the seed: 1 Caesar Salad, 3 Grilled Salmon, 4 Margherita Pizza, 5 Ribeye Steak.\n\nRun the whole collection in order with the Collection Runner: \"2. Create\" saves the order ids that \"3. Lifecycle\" and \"4. Cancel\" use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "cancelOrderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Queue",
      "item": [
        {
          "name": "Active queue (received + preparing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sorted by score, highest first', () => { const scores = pm.response.json().orders.map((o) => o.score); pm.expect(scores).to.eql([...scores].sort((a, b) => b - a)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ]
            },
            "description": "Ranked by score, then promised_at (null last), placed_at and id. Each order carries score, score_breakdown, allowed_actions and ahead_of_next."
          }
        },
        {
          "name": "Only received",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/queue?status=received",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "received"
                }
              ]
            }
          }
        },
        {
          "name": "Only preparing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/queue?status=preparing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "preparing"
                }
              ]
            }
          }
        },
        {
          "name": "Invalid filter -> 400 INVALID_STATUS_FILTER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code INVALID_STATUS_FILTER', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_STATUS_FILTER'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/queue?status=ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ready"
                }
              ]
            }
          }
        },
        {
          "name": "Ready for pickup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "ready"
              ]
            }
          }
        },
        {
          "name": "Finished (last 20)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/finished",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "finished"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Create",
      "item": [
        {
          "name": "Create order -> 201 (saves orderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('order is received', () => pm.expect(pm.response.json().order.status).to.eql('received'));",
                  "pm.collectionVariables.set('orderId', pm.response.json().order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Nora Blake\",\n  \"type\": \"takeout\",\n  \"is_vip\": true,\n  \"promised_at\": null,\n  \"items\": [\n    {\n      \"menu_item_id\": 3,\n      \"quantity\": 2\n    },\n    {\n      \"menu_item_id\": 1,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Create order to cancel -> 201 (saves cancelOrderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cancelOrderId', pm.response.json().order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Omar Haddad\",\n  \"type\": \"delivery\",\n  \"is_vip\": false,\n  \"promised_at\": null,\n  \"items\": [\n    {\n      \"menu_item_id\": 4,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Empty items -> 400 VALIDATION_ERROR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Nora Blake\",\n  \"type\": \"takeout\",\n  \"is_vip\": false,\n  \"promised_at\": null,\n  \"items\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Unknown menu item -> 400 VALIDATION_ERROR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Nora Blake\",\n  \"type\": \"takeout\",\n  \"is_vip\": false,\n  \"promised_at\": null,\n  \"items\": [\n    {\n      \"menu_item_id\": 9999,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Several invalid fields -> 400, all listed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('lists every invalid field', () => pm.expect(pm.response.json().error.details.errors.map((e) => e.field)).to.eql(['customer_name', 'type', 'is_vip', 'promised_at', 'items[0].quantity']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"\",\n  \"type\": \"catering\",\n  \"is_vip\": \"yes\",\n  \"promised_at\": \"tomorrow\",\n  \"items\": [\n    {\n      \"menu_item_id\": 1,\n      \"quantity\": 0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Malformed JSON -> 400 BAD_REQUEST",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code BAD_REQUEST', () => pm.expect(pm.response.json().error.code).to.eql('BAD_REQUEST'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"customer_name\": \"Nora\", ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Lifecycle (uses orderId)",
      "item": [
        {
          "name": "Start -> preparing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('order is preparing', () => pm.expect(pm.response.json().order.status).to.eql('preparing'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "start"
              ]
            }
          }
        },
        {
          "name": "Start again -> 409 INVALID_TRANSITION",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code INVALID_TRANSITION', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_TRANSITION'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "start"
              ]
            },
            "description": "Repeating a transition is an error, not a silent success. The order is unchanged."
          }
        },
        {
          "name": "Cancel while preparing -> 409 INVALID_TRANSITION",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code INVALID_TRANSITION', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_TRANSITION'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Ready -> ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('order is ready', () => pm.expect(pm.response.json().order.status).to.eql('ready'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "ready"
              ]
            }
          }
        },
        {
          "name": "Pickup -> picked_up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('order is picked_up', () => pm.expect(pm.response.json().order.status).to.eql('picked_up'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/pickup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "pickup"
              ]
            }
          }
        },
        {
          "name": "Start a picked-up order -> 409 INVALID_TRANSITION",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code INVALID_TRANSITION', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_TRANSITION'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "start"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Cancel (uses cancelOrderId)",
      "item": [
        {
          "name": "Skip a step: ready from received -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code INVALID_TRANSITION', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_TRANSITION'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{cancelOrderId}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{cancelOrderId}}",
                "ready"
              ]
            }
          }
        },
        {
          "name": "Cancel -> cancelled",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
